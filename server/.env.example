# Copier ce fichier en .env et remplir les vraies valeurs (.env ne va JAMAIS sur git)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/volunteer_organizer
# Mettre true pour Supabase / Neon (connexion SSL obligatoire)
DB_SSL=false
# Longue chaine aleatoire. Pour en generer une :
# node -p "require('crypto').randomBytes(32).toString('hex')"
JWT_SECRET=JWT_SECRET
PORT=3000
# Limites de requetes (Session 21). En local on monte la limite pour pouvoir relancer les tests d'API.
API_RATE_LIMIT_MAX=3000
# LOGIN_RATE_LIMIT_MAX=5
# En production (Render) : NODE_ENV=production rend CLIENT_ORIGIN obligatoire au demarrage
# NODE_ENV=production
CLIENT_ORIGIN=http://localhost:5173
# Emails (Resend). Vide = l'API marche, les emails sont simplement ignores. Voir DEPLOYMENT.md etape 5.
RESEND_API_KEY=
# EMAIL_FROM=Volunteer Organizer <noreply@votre-domaine>
# Secret pour POST /api/cron/reminders (rappels appeles par GitHub Actions). Vide = route desactivee.
# Meme generateur que JWT_SECRET, mais une AUTRE valeur.
CRON_SECRET=
